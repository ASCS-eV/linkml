	<http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .
<https://w3id.org/biolink/vocab/MaterialSample> a <http://www.w3.org/2002/07/owl#Class> , <https://w3id.org/linkml/ClassDefinition> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "material sample" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/biolink/vocab/PhysicalEntity> , <https://w3id.org/biolink/vocab/SubjectOfInvestigation> ;
	<http://www.w3.org/2004/02/skos/core#altLabel> "biosample" , "biospecimen" , "physical sample" , "sample" ;
	<http://www.w3.org/2004/02/skos/core#definition> "A sample is a limited quantity of something (e.g. an individual or set of individuals from a population, or a portion of a substance) to be used for testing, analysis, inspection, investigation, demonstration, or trial use. [SIO]" ;
	<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/OBI_0000747> , <http://semanticscience.org/resource/SIO_001050> ;
	<http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .
<https://w3id.org/biolink/vocab/MaterialSampleDerivationAssociation> a <http://www.w3.org/2002/07/owl#Class> , <https://w3id.org/linkml/ClassDefinition> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "material sample derivation association" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/biolink/vocab/Association> , _:c14n1096 , _:c14n1534 , _:c14n1739 , _:c14n339 , _:c14n620 , _:c14n630 , _:c14n707 , _:c14n760 , _:c14n833 ;
