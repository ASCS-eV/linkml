	<http://www.w3.org/2000/01/rdf-schema#label> "pathological entity mixin" ;
	<http://www.w3.org/2004/02/skos/core#definition> "A pathological (abnormal) structure or process." ;
	<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/MPATH_0> ;
	<http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> ;
	<http://www.w3.org/2004/02/skos/core#narrowMatch> <http://purl.obolibrary.org/obo/HP_0000118> .
