	<http://www.w3.org/2000/01/rdf-schema#label> "physically interacts with" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://w3id.org/biolink/vocab/interacts_with> ;
	<http://www.w3.org/2004/02/skos/core#broadMatch> <https://www.wikidata.org/prop/P129> ;
	<http://www.w3.org/2004/02/skos/core#closeMatch> <http://identifiers.org/drugbank/target> , <https://www.ebi.ac.uk/chembl/mechanism/inspect/binding_agent> , <https://www.ebi.ac.uk/chembl/mechanism/inspect/chelating_agent> , <https://www.ebi.ac.uk/chembl/mechanism/inspect/cross-linking_agent> , <https://www.ebi.ac.uk/chembl/mechanism/inspect/oxidative_enzyme> , <https://www.ebi.ac.uk/chembl/mechanism/inspect/sequestering_agent> , <https://www.ebi.ac.uk/chembl/mechanism/inspect/substrate> ;
	<http://www.w3.org/2004/02/skos/core#definition> "holds between two entities that make physical contact as part of some interaction. does not imply a causal relationship." ;
	<http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> ;
	<http://www.w3.org/2004/02/skos/core#narrowMatch> <http://identifiers.org/drugbank/drug-interaction> , <http://purl.obolibrary.org/obo/FMA_adheres_to> , <http://purl.obolibrary.org/obo/NCIT_A7> , <http://purl.obolibrary.org/obo/PR_non-covalently_bound_to> ;
	<https://w3id.org/biolink/vocab/canonical_predicate> true .
