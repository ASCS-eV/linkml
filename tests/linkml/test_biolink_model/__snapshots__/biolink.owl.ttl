<https://w3id.org/biolink/vocab/has_adverse_event> a <http://www.w3.org/2002/07/owl#ObjectProperty> , <https://w3id.org/linkml/SlotDefinition> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/biolink/vocab/ChemicalOrDrugOrTreatment> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has adverse event" ;
