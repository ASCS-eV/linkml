	<http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .
<https://w3id.org/biolink/vocab/population_context_qualifier> a <http://www.w3.org/2002/07/owl#ObjectProperty> , <https://w3id.org/linkml/SlotDefinition> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "population context qualifier" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://w3id.org/biolink/vocab/PopulationOfIndividualOrganisms> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://w3id.org/biolink/vocab/qualifier> ;
	<http://www.w3.org/2004/02/skos/core#definition> "a biological population (general, study, cohort, etc.) with a specific set of characteristics to constrain an association." ;
	<http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .
<https://w3id.org/biolink/vocab/positively_correlated_with> a <http://www.w3.org/2002/07/owl#ObjectProperty> , <http://www.w3.org/2002/07/owl#SymmetricProperty> , <https://w3id.org/linkml/SlotDefinition> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/biolink/vocab/NamedThing> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "positively correlated with" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://w3id.org/biolink/vocab/NamedThing> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://w3id.org/biolink/vocab/correlated_with> ;
	<http://www.w3.org/2004/02/skos/core#definition> "A relationship that holds between two concepts represented by variables for which a statistical correlation is demonstrated, wherein variable values move together in the same direction (i.e. increased in one or presence of one correlates with an increase or presence of the other)." ;
	<http://www.w3.org/2004/02/skos/core#exactMatch> <http://ctdbase.org/positive_correlation> ;
	<http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> ;
	<https://w3id.org/biolink/vocab/canonical_predicate> true ;
	<https://w3id.org/biolink/vocab/opposite_of> "negatively correlated with" .
<https://w3id.org/biolink/vocab/preceded_by> a <http://www.w3.org/2002/07/owl#ObjectProperty> , <https://w3id.org/linkml/SlotDefinition> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/biolink/vocab/Occurrent> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "preceded by" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://w3id.org/biolink/vocab/Occurrent> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://w3id.org/biolink/vocab/temporally_related_to> ;
	<http://www.w3.org/2002/07/owl#inverseOf> <https://w3id.org/biolink/vocab/precedes> ;
	<http://www.w3.org/2004/02/skos/core#broadMatch> <http://purl.obolibrary.org/obo/GENEPIO_0001739> ;
	<http://www.w3.org/2004/02/skos/core#definition> "holds between two processes, where the other is completed before the one begins" ;
	<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/BFO_0000062> ;
	<http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> ;
	<http://www.w3.org/2004/02/skos/core#narrowMatch> <http://purl.obolibrary.org/obo/FMA_transforms_from> , <http://purl.obolibrary.org/obo/RO_0002087> , <http://purl.obolibrary.org/obo/RO_0002285> .
