<https://w3id.org/biolink/vocab/Activity> a <http://www.w3.org/2002/07/owl#Class> , <https://w3id.org/linkml/ClassDefinition> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "activity" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/biolink/vocab/ActivityAndBehavior> , <https://w3id.org/biolink/vocab/NamedThing> ;
	<http://www.w3.org/2004/02/skos/core#definition> "An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities." ;
	<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.bioontology.org/ontology/STY/T052> , <http://purl.obolibrary.org/obo/NCIT_C43431> , <http://www.w3.org/ns/prov#Activity> ;
	<http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> ;
	<http://www.w3.org/2004/02/skos/core#narrowMatch> <http://purl.bioontology.org/ontology/STY/T056> , <http://purl.bioontology.org/ontology/STY/T057> , <http://purl.bioontology.org/ontology/STY/T058> , <http://purl.bioontology.org/ontology/STY/T062> , <http://purl.bioontology.org/ontology/STY/T064> , <http://purl.bioontology.org/ontology/STY/T065> , <http://purl.bioontology.org/ontology/STY/T066> .
<https://w3id.org/biolink/vocab/ActivityAndBehavior> a <http://www.w3.org/2002/07/owl#Class> , <https://w3id.org/linkml/ClassDefinition> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "activity and behavior" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/biolink/vocab/Occurrent> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Activity or behavior of any independent integral living, organization or mechanical actor in the world" ;
