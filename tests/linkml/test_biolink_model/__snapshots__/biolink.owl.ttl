	<http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .
<https://w3id.org/biolink/vocab/OrganismalEntity> a <http://www.w3.org/2002/07/owl#Class> , <https://w3id.org/linkml/ClassDefinition> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "organismal entity" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/biolink/vocab/BiologicalEntity> , <https://w3id.org/biolink/vocab/SubjectOfInvestigation> , _:c14n1271 , _:c14n1735 , _:c14n1869 ;
	<http://www.w3.org/2004/02/skos/core#definition> "A named entity that is either a part of an organism, a whole organism, population or clade of organisms, excluding chemical entities" ;
	<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CARO_0001010> , <https://lhncbc.nlm.nih.gov/semanticnetwork/download/sg_archive/SemGroups-v04.txtLIVB> , <https://www.wikidata.org/entity/Q7239> ;
	<http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> ;
	<http://www.w3.org/2004/02/skos/core#narrowMatch> <http://purl.bioontology.org/ontology/STY/T008> .
<https://w3id.org/biolink/vocab/OrganismalEntityAsAModelOfDiseaseAssociation> a <http://www.w3.org/2002/07/owl#Class> , <https://w3id.org/linkml/ClassDefinition> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "organismal entity as a model of disease association" ;
