	<http://www.w3.org/2004/02/skos/core#narrowMatch> <http://purl.obolibrary.org/obo/HsapDv_0000000> .
<https://w3id.org/biolink/vocab/LogOddsAnalysisResult> a <http://www.w3.org/2002/07/owl#Class> , <https://w3id.org/linkml/ClassDefinition> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "log odds analysis result" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/biolink/vocab/StudyResult> ;
	<http://www.w3.org/2004/02/skos/core#definition> "A result of a log odds ratio analysis." ;
	<http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .
<https://w3id.org/biolink/vocab/LogicalInterpretationEnum#inverse_all_some> a <http://www.w3.org/2002/07/owl#Class> , <https://w3id.org/biolink/vocab/LogicalInterpretationEnum> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "inverse_all_some" ;
