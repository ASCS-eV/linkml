<https://w3id.org/biolink/vocab/ClinicalCourse> a <http://www.w3.org/2002/07/owl#Class> , <https://w3id.org/linkml/ClassDefinition> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "clinical course" ;
