	<http://www.w3.org/2000/01/rdf-schema#label> "regulatory region" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/biolink/vocab/BiologicalEntity> , <https://w3id.org/biolink/vocab/ChemicalEntityOrGeneOrGeneProduct> , <https://w3id.org/biolink/vocab/GenomicEntity> , <https://w3id.org/biolink/vocab/OntologyClass> , <https://w3id.org/biolink/vocab/PhysicalEssence> ;
	<http://www.w3.org/2004/02/skos/core#altLabel> "regulatory element" ;
	<http://www.w3.org/2004/02/skos/core#definition> "A region (or regions) of the genome that contains known or putative regulatory elements that act in cis- or trans- to affect the transcription of gene" ;
	<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/SO_0005836> , <http://semanticscience.org/resource/SIO_001225> , <https://www.wikidata.org/entity/Q3238407> ;
