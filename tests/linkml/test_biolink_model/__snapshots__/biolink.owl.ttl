	<http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> ;
	<http://www.w3.org/2004/02/skos/core#narrowMatch> <http://ctdbase.org/marker_mechanism> , <http://purl.obolibrary.org/obo/MONDO_predisposes_towards> , <http://purl.obolibrary.org/obo/RO_0002255> , <http://purl.obolibrary.org/obo/RO_0003304> ;
	<https://w3id.org/biolink/vocab/canonical_predicate> true .
