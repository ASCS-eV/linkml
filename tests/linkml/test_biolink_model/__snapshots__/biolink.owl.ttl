	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/biolink/vocab/OntologyClass> , _:c14n1179 , _:c14n1881 , _:c14n335 ;
	<http://www.w3.org/2004/02/skos/core#altLabel> "experimental condition" , "exposure" ;
	<http://www.w3.org/2004/02/skos/core#definition> "A (possibly time bounded) incidence of a feature of the environment of an organism that influences one or more phenotypic features of that organism, potentially mediated by genes" ;
	<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/XCO_0000000> ;
	<http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .
<https://w3id.org/biolink/vocab/ExposureEventToOutcomeAssociation> a <http://www.w3.org/2002/07/owl#Class> , <https://w3id.org/linkml/ClassDefinition> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "exposure event to outcome association" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/biolink/vocab/Association> , <https://w3id.org/biolink/vocab/EntityToOutcomeAssociationMixin> , _:c14n1162 , _:c14n1628 , _:c14n1851 , _:c14n388 , _:c14n820 , _:c14n993 ;
