	<http://www.w3.org/2000/01/rdf-schema#label> "supporting_data_source" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/biolink/vocab/ResourceRoleEnum> .
<https://w3id.org/biolink/vocab/ResourceRoleEnum> a <http://www.w3.org/2002/07/owl#Class> , <https://w3id.org/linkml/EnumDefinition> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ResourceRoleEnum" ;
	<http://www.w3.org/2002/07/owl#unionOf> _:c14n1861 ;
