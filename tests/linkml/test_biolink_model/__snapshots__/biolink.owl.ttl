	<http://www.w3.org/2000/01/rdf-schema#label> "genome" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/biolink/vocab/BiologicalEntity> , <https://w3id.org/biolink/vocab/GenomicEntity> , <https://w3id.org/biolink/vocab/OntologyClass> , <https://w3id.org/biolink/vocab/PhysicalEssence> ;
	<http://www.w3.org/2004/02/skos/core#closeMatch> <https://datacommons.org/browser/GenomeAssemblyUnit> ;
	<http://www.w3.org/2004/02/skos/core#definition> "A genome is the sum of genetic material within a cell or virion." ;
	<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/SO_0001026> , <http://semanticscience.org/resource/SIO_000984> , <https://www.wikidata.org/entity/Q7020> ;
	<http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .
